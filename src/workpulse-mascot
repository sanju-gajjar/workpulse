    def on_add_reminder(self, widget=None):
        """Add a custom scheduled reminder"""
        try:
            # Ask for time
            result = subprocess.run(
                ['zenity', '--entry',
                 '--title=Add Reminder',
                 '--text=What time should I remind you?\nFormat: HH:MM (24-hour)',
                 '--entry-text=09:00',
                 '--width=300'],
                capture_output=True, text=True, timeout=60
            )
            if result.returncode != 0 or not result.stdout.strip():
                return
            
            time_str = result.stdout.strip()
            # Validate time format
            parts = time_str.split(':')
            if len(parts) != 2:
                self.notify("WorkPulse", "Invalid time format. Use HH:MM")
                return
            
            try:
                hour = int(parts[0])
                minute = int(parts[1])
                if not (0 <= hour <= 23 and 0 <= minute <= 59):
                    raise ValueError()
                time_str = f"{hour:02d}:{minute:02d}"
            except:
                self.notify("WorkPulse", "Invalid time. Use HH:MM (00:00 - 23:59)")
                return
            
            # Ask for message
            result = subprocess.run(
                ['zenity', '--entry',
                 '--title=Add Reminder',
                 f'--text=What should I remind you at {time_str}?',
                 '--entry-text=Take a break!',
                 '--width=400'],
                capture_output=True, text=True, timeout=60
            )
            if result.returncode != 0 or not result.stdout.strip():
                return
            
            message = result.stdout.strip()
            
            # Add to reminders
            self.scheduled_reminders.append({
                'time': time_str,
                'message': message
            })
            self.save_settings()
            
            self.speech_bubble.set_message(f"Reminder set for {time_str}! ⏰")
            self.notify("WorkPulse", f"Reminder added for {time_str}: {message}")
            
        except Exception as e:
            pass
    
    def on_delete_reminder(self, index):
        """Delete a scheduled reminder"""
        try:
            if 0 <= index < len(self.scheduled_reminders):
                removed = self.scheduled_reminders.pop(index)
                self.save_settings()
                self.speech_bubble.set_message("Reminder removed! 🗑️")
        except:
            pass
    
    def on_copy_report(self, widget=None):
        """Generate and copy standup report to clipboard"""
        try:
            # Generate report
            self.run_cmd("workpulse export standup")
            
            # Find the latest report file
            report_file = subprocess.run(
                "ls -t ~/.local/share/workpulse/exports/*standup*.md 2>/dev/null | head -1",
                shell=True, capture_output=True, text=True
            ).stdout.strip()
            
            if report_file and os.path.exists(report_file):
                # Read report content
                with open(report_file, 'r') as f:
                    content = f.read()
                
                # Copy to clipboard using xclip or xsel
                try:
                    # Try xclip first
                    process = subprocess.Popen(['xclip', '-selection', 'clipboard'],
                                             stdin=subprocess.PIPE)
                    process.communicate(content.encode())
                    copied = process.returncode == 0
                except:
                    try:
                        # Fall back to xsel
                        process = subprocess.Popen(['xsel', '--clipboard', '--input'],
                                                 stdin=subprocess.PIPE)
                        process.communicate(content.encode())
                        copied = process.returncode == 0
                    except:
                        copied = False
                
                if copied:
                    self.speech_bubble.set_message("Copied! 📋✅")
                    self.notify("WorkPulse", "Standup report copied to clipboard!\nPaste it into ClickUp/Jira.")
                else:
                    # Fallback: show in zenity for manual copy
                    subprocess.Popen(['zenity', '--text-info', '--title=Standup Report (Copy from here)', 
                                    '--filename=' + report_file, '--width=500', '--height=400'],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    self.speech_bubble.set_message("Copy from dialog 📋")
            else:
                self.notify("WorkPulse", "No report found. Make sure you have tracked time today.")
        except Exception as e:
            self.notify("WorkPulse", f"Error: {str(e)}")

