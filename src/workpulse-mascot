class WorkPulseMascot(Gtk.Window):
    def __init__(self):
        super().__init__(title="WorkPulse Mascot")
        
        # Make window transparent and borderless
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_resizable(False)
        # Use DOCK type hint for always-on-top behavior on Wayland
        self.set_type_hint(Gdk.WindowTypeHint.DOCK)
        self.set_app_paintable(True)
        # Don't accept focus to avoid interfering with other windows
        self.set_accept_focus(False)
        
        # Enable transparency
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)
        
        # Character size (configurable: small=60, medium=90, large=120)
        self.size = 90  # Default medium
        self.size_name = "medium"  # small, medium, large
        self.bubble_height = 100  # Extra space for speech bubble (up to 4 lines)
        self.is_tracking = False
        self.is_paused = False
        self.today_hours = 0
        self.current_task = ""
        self.task_start_time = None
        self.elapsed_seconds = 0
        self.paused_tasks = []
        self.task_history = []
        self.history_file = os.path.expanduser("~/.local/share/workpulse/task_history.json")
        self.settings_file = os.path.expanduser("~/.local/share/workpulse/mascot_settings.json")
        
        # Personalization settings
        self.mascot_name = "KIKI"  # Default mascot name
        self.user_name = "sanju"    # Default user name
        self.mascot_theme = "blob"  # Default theme
        self.eod_reminder_hour = 17  # Default 5 PM
        self.eod_reminder_minute = 30  # Default 5:30 PM
        self.show_system_notifications = True  # Show system notifications
        self.show_all_notifications = False    # Only priority apps by default
        
        # Custom scheduled reminders (list of {"time": "HH:MM", "message": "text"})
        self.scheduled_reminders = []
