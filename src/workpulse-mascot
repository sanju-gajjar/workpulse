    def on_button_press(self, widget, event):
        if event.button == 1:
            # Left click - start drag using Wayland-compatible method
            # For undecorated windows, use begin_move_drag which works on Wayland
            window = self.get_window()
            if window:
                window.begin_move_drag(
                    event.button,
                    int(event.x_root),
                    int(event.y_root),
                    event.time
                )
        elif event.button == 3:
            # Right click - show menu
            if self.menu:
                self.menu.popdown()
            self.menu = self.create_menu()
            # Use popup_at_pointer for Wayland compatibility
            self.menu.popup_at_pointer(event)
    
    def on_button_release(self, widget, event):
        # No need to handle release for begin_move_drag
        pass
    
    def on_motion(self, widget, event):
        # Motion is handled by begin_move_drag automatically
        pass
    
    def clean_task_name(self, task):
        if not task:
            return ""
        task = re.sub(r'\+\w+', '', task)
        task = task.replace('"', '').replace("'", "")
        return task.strip()
    
    def run_cmd(self, cmd):
        try:
            result = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=5)
            return result.stdout.strip()
        except:
            return ""
    
    def update_status(self):
        try:
            status = self.run_cmd("timeout 3 workpulse status 2>/dev/null")
            
            task = ""
            for line in status.split('\n'):
                if "Current Task:" in line:
                    task = line.split("Current Task:")[-1].strip()
                    break
            
            task = self.clean_task_name(task)
            was_tracking = self.is_tracking
            self.is_tracking = task and task != "None"
            
            if self.is_tracking and not was_tracking:
                self.current_task = task
                self.task_start_time = time.time()
                self.elapsed_seconds = 0
                self.is_paused = False
                self.continuous_work_start = time.time()
                self.add_to_history(task)
                self.mascot.change_random_state(True, False)
            elif not self.is_tracking:
                self.current_task = ""
                self.task_start_time = None
                self.elapsed_seconds = 0
                self.continuous_work_start = None
                self.mascot.change_random_state(False, False)
            
            for line in status.split('\n'):
                if "Today's Total:" in line:
                    time_str = line.split("Today's Total:")[-1].strip()
                    try:
                        self.today_hours = float(time_str.split()[0])
                    except:
                        self.today_hours = 0
                    break
        except:
            pass
        
        return True
    
    def notify(self, title, msg):
        # Use mascot name in title for personal touch
        display_title = title.replace("WorkPulse", self.mascot_name)
        subprocess.Popen(['notify-send', '-i', 'appointment-soon', display_title, msg],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    
    def on_quick_start(self, widget, task):
        if self.is_tracking and self.current_task:
            self.paused_tasks.insert(0, {
                'task': self.current_task,
                'elapsed': self.elapsed_seconds,
                'paused_at': time.time()
            })
            self.save_history()
        
        self.run_cmd(f'workpulse start "{task}"')
        self.current_task = task
        self.task_start_time = time.time()
        self.elapsed_seconds = 0
        self.is_tracking = True
        self.is_paused = False
        self.continuous_work_start = time.time()
        self.add_to_history(task)
        self.mascot.change_random_state(True, False)
        
        # Personal touch messages
        start_messages = [
            f"Let's go, {self.user_name}! 🚀",
            f"Starting: {task[:15]}...",
            "Focus time! 🎯",
            f"You got this! 💪",
            "Let's crush it!",
        ]
        self.speech_bubble.set_message(random.choice(start_messages))
        self.notify("WorkPulse", f"Started: {task}")
    
    def on_custom_task(self, widget=None):
        try:
            result = subprocess.run(
                ['zenity', '--entry', '--title=WorkPulse', '--text=What are you working on?', '--width=350'],
                capture_output=True, text=True, timeout=60
            )
            if result.returncode == 0 and result.stdout.strip():
                task = result.stdout.strip()
                self.on_quick_start(None, task)
        except:
            pass
    
    def on_pause(self, widget=None):
        if self.is_tracking:
            if self.is_paused:
                self.is_paused = False
                self.task_start_time = time.time() - self.elapsed_seconds
                self.run_cmd(f'workpulse start "{self.current_task}"')
                self.mascot.change_random_state(True, False)
                self.notify("WorkPulse", f"Resumed: {self.current_task}")
            else:
                self.is_paused = True
                self.paused_tasks.insert(0, {
                    'task': self.current_task,
                    'elapsed': self.elapsed_seconds,
                    'paused_at': time.time()
                })
                self.save_history()
                self.run_cmd("workpulse stop")
                self.mascot.change_random_state(True, True)
                self.notify("WorkPulse", f"Paused: {self.current_task}")
    
    def on_resume_paused(self, widget, task_info):
        task = task_info.get('task', '')
        elapsed = task_info.get('elapsed', 0)
        
        self.paused_tasks = [t for t in self.paused_tasks if t.get('task') != task]
        self.save_history()
        
        if self.is_tracking and self.current_task:
            self.paused_tasks.insert(0, {
                'task': self.current_task,
                'elapsed': self.elapsed_seconds,
                'paused_at': time.time()
            })
            self.save_history()
        
        self.run_cmd(f'workpulse start "{task}"')
        self.current_task = task
        self.elapsed_seconds = elapsed
        self.task_start_time = time.time() - elapsed
        self.is_tracking = True
        self.is_paused = False
        self.continuous_work_start = time.time()
        self.mascot.change_random_state(True, False)
        self.notify("WorkPulse", f"Resumed: {task}")
    
    def on_stop(self, widget=None):
        self.run_cmd("workpulse stop")
        if self.current_task:
            self.add_to_history(self.current_task)
        self.is_tracking = False
        self.is_paused = False
        self.current_task = ""
        self.task_start_time = None
        self.elapsed_seconds = 0
        self.continuous_work_start = None
        self.mascot.change_random_state(False, False)
        
        # Encouraging stop messages
        stop_messages = [
            f"Great work, {self.user_name}! ✨",
            "Task complete! 🎉",
            "Nice job! 👏",
            "Well done! ⭐",
        ]
        self.speech_bubble.set_message(random.choice(stop_messages))
        self.notify("WorkPulse", "Tracking stopped")
        GLib.timeout_add(500, self.update_status)
    
