        self.auto_track_meetings = True  # Enable automatic meeting tracking
        self.in_meeting = False
        self.meeting_app = None
        self.meeting_task_name = None
        
        self.load_settings()
        
        # Speech bubble system
        self.speech_bubble = SpeechBubble(self.user_name)
        self.just_started = True  # For initial greeting
        
        # Notification listener (for system notifications)
        self.notification_listener = NotificationListener(self._on_system_notification)
        if HAS_DBUS and self.show_system_notifications:
            self.notification_listener.start()
        
        # Git activity monitor
        self.git_monitor = GitActivityMonitor()
        
        # Sleepy mode tracking
        self.idle_start_time = time.time()
        self.sleepy_threshold = 600  # 10 minutes idle = sleepy mode
        self.is_sleepy = False
        
        # End of day reminder
        self.eod_reminded_today = False
        self.last_eod_check_date = None
        
        # Idle detection
        self.last_activity_time = time.time()
        self.idle_threshold = 300
        self.was_idle = False
        
        # Break reminder
        self.continuous_work_start = None
        self.break_reminder_threshold = 7200
        self.last_break_reminder = 0
        
        # The mascot character
        self.mascot = MascotCharacter(self.mascot_theme)
        self.mascot.tamagotchi = True
        
        # Set window size (bigger for character + speech bubble)
        self.set_size_request(self.size + 80, self.size + self.bubble_height + 30)
        
        # Position bottom-right
        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor()
        if monitor is None:
            # Fallback: get first monitor
            monitor = display.get_monitor(0)
        if monitor is not None:
            geometry = monitor.get_geometry()
            self.move(geometry.width - self.size - 80, geometry.height - self.size - 140)
        else:
            # Ultimate fallback: use screen dimensions
            screen = self.get_screen()
            self.move(screen.get_width() - self.size - 80, screen.get_height() - self.size - 140)
        
        # Load task history
        self.load_history()
        
        # Drawing area
        self.drawing_area = Gtk.DrawingArea()
        self.drawing_area.set_size_request(self.size + 80, self.size + self.bubble_height + 30)
        self.drawing_area.connect("draw", self.on_draw)
        
        # Mouse events - connect to drawing area to receive input
        self.drawing_area.add_events(
            Gdk.EventMask.BUTTON_PRESS_MASK |
            Gdk.EventMask.BUTTON_RELEASE_MASK |
            Gdk.EventMask.POINTER_MOTION_MASK |
            Gdk.EventMask.ENTER_NOTIFY_MASK |
            Gdk.EventMask.LEAVE_NOTIFY_MASK
        )
        self.drawing_area.connect("button-press-event", self.on_button_press)
        self.drawing_area.connect("button-release-event", self.on_button_release)
        self.drawing_area.connect("motion-notify-event", self.on_motion)
        self.drawing_area.connect("enter-notify-event", self.on_enter)
        self.drawing_area.connect("leave-notify-event", self.on_leave)
        
        self.add(self.drawing_area)
        
        self.hover = False
        self.drag_x = self.drag_y = 0
        self.dragging = False
        self.click_time = 0
        
        # Popup menu
        self.menu = None
        
        # Timers
        GLib.timeout_add(50, self.update_animation)  # 20 FPS for smooth animation
        GLib.timeout_add(1000, self.update_timer)
        GLib.timeout_add(30000, self.update_status)
        GLib.timeout_add(60000, self.check_idle)
        GLib.timeout_add(300000, self.check_break_reminder)
        GLib.timeout_add(30000, self.check_git_activity)  # Check git every 30s
        GLib.timeout_add(60000, self.check_eod_reminder)  # Check EOD every minute
        GLib.timeout_add(30000, self.check_sleepy_mode)   # Check sleepy every 30s
        GLib.timeout_add(5000, self.ensure_on_top)  # Keep window on top every 5s
        GLib.timeout_add(10000, self.check_meeting_call)  # Check for meeting calls every 10s
        
        self.update_status()
        self.show_all()
        
        # Ensure window is on top after it's realized
        self.connect("realize", self._on_realize)
        
        # Show initial greeting after a short delay
        GLib.timeout_add(2000, self._show_initial_greeting)
    
    def _on_realize(self, widget):
        """Called when window is realized - ensure it's on top"""
        self.ensure_on_top()
    
    def ensure_on_top(self):
        """Periodically ensure window stays on top"""
        try:
            window = self.get_window()
            if window:
                # Re-assert keep_above for Wayland/X11
                self.set_keep_above(True)
                # Raise to top of stacking order
                window.raise_()
        except:
            pass
        return True  # Continue timer
    
    def _show_initial_greeting(self):
        """Show greeting when mascot first starts"""
        if self.just_started:
            self.speech_bubble.set_message(self.speech_bubble.get_time_based_greeting())
            self.just_started = False
        return False  # Don't repeat
    
    def _on_system_notification(self, text, app_name):
        """Callback when a system notification is received"""
        if self.show_system_notifications:
            self.speech_bubble.set_message(text)
            # Wake up if sleepy
            if self.is_sleepy:
                self.is_sleepy = False
                self.mascot.set_sleepy(False)
    
    def load_settings(self):
        """Load personalization settings"""
        try:
            os.makedirs(os.path.dirname(self.settings_file), exist_ok=True)
            if os.path.exists(self.settings_file):
                with open(self.settings_file, 'r') as f:
                    data = json.load(f)
                    self.mascot_name = data.get('mascot_name', 'KIKI')
                    self.user_name = data.get('user_name', 'sanju')
                    self.mascot_theme = data.get('mascot_theme', 'blob')
                    self.eod_reminder_hour = data.get('eod_reminder_hour', 17)
                    self.eod_reminder_minute = data.get('eod_reminder_minute', 30)
                    self.show_system_notifications = data.get('show_system_notifications', True)
                    self.show_all_notifications = data.get('show_all_notifications', False)
                    # Size setting
                    self.size_name = data.get('size', 'medium')
                    self._apply_size()
                    # Custom scheduled reminders
                    self.scheduled_reminders = data.get('scheduled_reminders', [])
                    # Auto-track meetings
                    self.auto_track_meetings = data.get('auto_track_meetings', True)
        except:
            pass
    
    def _apply_size(self):
        """Apply size based on size_name"""
        sizes = {'small': 60, 'medium': 90, 'large': 120}
        self.size = sizes.get(self.size_name, 90)
        # Increased bubble height to accommodate up to 4 lines of text
        self.bubble_height = 80 if self.size_name == 'small' else 100
    
    def save_settings(self):
        """Save personalization settings"""
        try:
            os.makedirs(os.path.dirname(self.settings_file), exist_ok=True)
            with open(self.settings_file, 'w') as f:
                json.dump({
                    'mascot_name': self.mascot_name,
                    'user_name': self.user_name,
                    'mascot_theme': self.mascot_theme,
                    'eod_reminder_hour': self.eod_reminder_hour,
                    'eod_reminder_minute': self.eod_reminder_minute,
                    'show_system_notifications': self.show_system_notifications,
                    'show_all_notifications': self.show_all_notifications,
                    'size': self.size_name,
                    'scheduled_reminders': self.scheduled_reminders,
                    'auto_track_meetings': self.auto_track_meetings
                }, f, indent=2)
            # Update speech bubble with new name
            self.speech_bubble.set_user_name(self.user_name)
            # Update mascot theme
            self.mascot.set_theme(self.mascot_theme)
            # Update notification listener
            if hasattr(self, 'notification_listener'):
                self.notification_listener.set_enabled(self.show_system_notifications)
                self.notification_listener.set_show_all(self.show_all_notifications)
        except:
            pass
    
    def load_history(self):
        try:
            os.makedirs(os.path.dirname(self.history_file), exist_ok=True)
            if os.path.exists(self.history_file):
                with open(self.history_file, 'r') as f:
                    data = json.load(f)
                    self.task_history = data.get('history', [])[:10]
                    self.paused_tasks = data.get('paused', [])
        except:
            self.task_history = []
            self.paused_tasks = []
    
    def save_history(self):
        try:
            os.makedirs(os.path.dirname(self.history_file), exist_ok=True)
            with open(self.history_file, 'w') as f:
                json.dump({
                    'history': self.task_history[:10],
                    'paused': self.paused_tasks
                }, f)
        except:
            pass
    
    def add_to_history(self, task):
        if task and task not in self.task_history:
            self.task_history.insert(0, task)
            self.task_history = self.task_history[:10]
            self.save_history()
    
    def remove_from_history(self, task):
        """Remove a task from recent history"""
        if task in self.task_history:
            self.task_history.remove(task)
            self.save_history()
    
    def clear_all_history(self):
        """Clear all recent task history"""
        self.task_history = []
        self.save_history()
    
    def remove_paused_task(self, task_info):
        """Remove a task from paused tasks list"""
        task = task_info.get('task', '')
        self.paused_tasks = [t for t in self.paused_tasks if t.get('task') != task]
        self.save_history()
    
    def clear_all_paused(self):
        """Clear all paused tasks"""
        self.paused_tasks = []
        self.save_history()
    
