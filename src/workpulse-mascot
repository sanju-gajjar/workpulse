    def on_draw(self, widget, cr):
        width = widget.get_allocated_width()
        height = widget.get_allocated_height()
        center_x = width / 2
        center_y = height / 2 + self.bubble_height / 2 - 5  # Offset for bubble
        
        # Clear background (transparent)
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        
        # Draw speech bubble if there's a message
        if self.speech_bubble.show_message and self.speech_bubble.current_message:
            # Position bubble higher to prevent overlap with mascot
            bubble_y = center_y - self.size/2 - 25
            self._draw_speech_bubble(cr, center_x, bubble_y, 
                                     self.speech_bubble.current_message)
        
        # Draw the mascot (new signature without tracking/paused params)
        self.mascot.draw(cr, center_x, center_y, self.size * 0.9)
        
        # Draw timer badge when tracking
        if self.is_tracking:
            self._draw_timer_badge(cr, width, height)
        elif self.today_hours > 0:
            self._draw_hours_badge(cr, width, height)
        
        # Draw mascot name badge on hover
        if self.hover:
            self._draw_name_badge(cr, center_x, center_y + self.size/2 + 5)
        
        # Hover glow
        if self.hover:
            cr.set_source_rgba(1, 1, 1, 0.1)
            cr.arc(center_x, center_y, self.size * 0.45, 0, 2 * math.pi)
            cr.fill()
        
        return False
    
    def _draw_speech_bubble(self, cr, x, y, text):
        """Draw a cute speech bubble above the mascot with auto-sizing"""
        if not text:
            return
            
        # Calculate text dimensions
        cr.select_font_face("Sans", cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        cr.set_font_size(10)
        
        # Determine max width based on text length (wider for longer messages)
        text_len = len(text)
        if text_len > 60:
            max_width = 200
        elif text_len > 40:
            max_width = 170
        else:
            max_width = 140
        
        # Word wrap for long messages
        words = text.split()
        lines = []
        current_line = ""
        
        for word in words:
            test_line = current_line + " " + word if current_line else word
            extents = cr.text_extents(test_line)
            if extents.width <= max_width:
                current_line = test_line
            else:
                if current_line:
                    lines.append(current_line)
                # Handle very long words (like URLs) - break them
                if cr.text_extents(word).width > max_width:
                    while word:
                        for i in range(len(word), 0, -1):
                            if cr.text_extents(word[:i]).width <= max_width:
                                lines.append(word[:i])
                                word = word[i:]
                                break
                        else:
                            lines.append(word)
                            word = ""
                    current_line = ""
                else:
                    current_line = word
        if current_line:
            lines.append(current_line)
        
        if not lines:
            return
        
        # Limit to 4 lines max, truncate if needed
        if len(lines) > 4:
            lines = lines[:4]
            lines[-1] = lines[-1][:len(lines[-1])-3] + "..."
            
        # Calculate bubble dimensions
        line_height = 14
        padding = 8
        max_line_width = max(cr.text_extents(line).width for line in lines)
        bubble_width = max(max_line_width + padding * 2, 60)  # Minimum width
        bubble_height = len(lines) * line_height + padding * 2
        
        bubble_x = x - bubble_width / 2
        bubble_y = y - bubble_height - 10  # 10px for the pointer
        
        # Ensure bubble stays within reasonable bounds
        bubble_x = max(5, min(bubble_x, self.get_allocated_width() - bubble_width - 5))
        
        # Draw bubble shadow
        cr.set_source_rgba(0, 0, 0, 0.15)
        self._draw_rounded_rect(cr, bubble_x + 2, bubble_y + 2, bubble_width, bubble_height, 12)
        cr.fill()
        
        # Draw bubble background (gradient-like effect)
        cr.set_source_rgba(1, 1, 1, 0.98)
        self._draw_rounded_rect(cr, bubble_x, bubble_y, bubble_width, bubble_height, 12)
        cr.fill()
        
        # Draw subtle border
        cr.set_source_rgba(0.8, 0.8, 0.8, 0.6)
        cr.set_line_width(1)
        self._draw_rounded_rect(cr, bubble_x, bubble_y, bubble_width, bubble_height, 12)
        cr.stroke()
        
        # Draw pointer (triangle pointing down) - position it centered on mascot
        pointer_x = x
        cr.set_source_rgba(1, 1, 1, 0.98)
        cr.move_to(pointer_x - 8, bubble_y + bubble_height)
        cr.line_to(pointer_x, bubble_y + bubble_height + 10)
        cr.line_to(pointer_x + 8, bubble_y + bubble_height)
        cr.close_path()
        cr.fill()
        
        # Draw pointer border
        cr.set_source_rgba(0.8, 0.8, 0.8, 0.6)
        cr.move_to(pointer_x - 8, bubble_y + bubble_height)
        cr.line_to(pointer_x, bubble_y + bubble_height + 10)
        cr.line_to(pointer_x + 8, bubble_y + bubble_height)
        cr.stroke()
        
        # Draw text (centered)
        cr.set_source_rgba(0.15, 0.15, 0.15, 1)
        for i, line in enumerate(lines):
            extents = cr.text_extents(line)
            text_x = bubble_x + (bubble_width - extents.width) / 2
            text_y = bubble_y + padding + (i + 1) * line_height - 3
            cr.move_to(text_x, text_y)
            cr.show_text(line)
    
