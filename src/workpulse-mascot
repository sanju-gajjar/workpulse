    def check_eod_reminder(self):
        """Check if it's time for end-of-day standup reminder"""
        try:
            now = time.localtime()
            today = (now.tm_year, now.tm_mon, now.tm_mday)
            
            # Reset reminder flag for new day
            if self.last_eod_check_date != today:
                self.last_eod_check_date = today
                self.eod_reminded_today = False
                self.triggered_reminders_today = set()  # Reset custom reminders too
            
            # Check if it's reminder time
            if not self.eod_reminded_today:
                if now.tm_hour == self.eod_reminder_hour and now.tm_min >= self.eod_reminder_minute:
                    self.eod_reminded_today = True
                    
                    # Show message and notification
                    eod_msg = self.speech_bubble.force_message("eod")
                    self.speech_bubble.set_message(eod_msg)
                    
                    self.notify("📋 End of Day Reminder", 
                               f"Hey {self.user_name}! Time to export your standup report.\n"
                               "Click me → Standup Report to copy your logs!")
                    
                    # Wake up if sleepy
                    if self.is_sleepy:
                        self.is_sleepy = False
                        self.mascot.set_sleepy(False)
                    
                    self.mascot.state = MascotCharacter.WAVING
                    self.mascot.state_timer = 0
            
            # Check custom scheduled reminders
            self._check_scheduled_reminders(now)
        except:
            pass
        return True
    
    def _check_scheduled_reminders(self, now):
        """Check custom scheduled reminders"""
        try:
            current_time = f"{now.tm_hour:02d}:{now.tm_min:02d}"
            
            for reminder in self.scheduled_reminders:
                reminder_time = reminder.get('time', '')
                reminder_msg = reminder.get('message', '')
                reminder_key = f"{reminder_time}:{reminder_msg}"
                
                if reminder_time == current_time and reminder_key not in self.triggered_reminders_today:
                    self.triggered_reminders_today.add(reminder_key)
                    
                    # Show the message
                    self.speech_bubble.set_message(f"⏰ {reminder_msg}")
                    self.notify(f"⏰ Reminder", reminder_msg)
                    
                    # Wake up if sleepy
                    if self.is_sleepy:
                        self.is_sleepy = False
                        self.mascot.set_sleepy(False)
                    
                    self.mascot.state = MascotCharacter.WAVING
                    self.mascot.state_timer = 0
        except:
            pass
        return True
    
    def check_meeting_call(self):
        """Detect active meeting calls (Zoom, Google Meet, Teams) and auto-track"""
        if not self.auto_track_meetings:
            return True
        
        try:
            # Get all window titles
            result = subprocess.run(
                ['wmctrl', '-l'],
                capture_output=True,
                text=True,
                timeout=2
            )
            
            if result.returncode != 0:
                return True
            
            windows = result.stdout.lower()
            current_in_meeting = False
            detected_app = None
            
            # Check for Zoom meeting
            if 'zoom meeting' in windows or 'zoom workplace' in windows:
                current_in_meeting = True
                detected_app = 'Zoom'
            
            # Check for Google Meet
            elif 'meet.google.com' in windows or '- google meet' in windows:
                current_in_meeting = True
                detected_app = 'Google Meet'
            
            # Check for Microsoft Teams
            elif 'microsoft teams' in windows and ('| call' in windows or '| meeting' in windows):
                current_in_meeting = True
                detected_app = 'Teams'
            
            # State change: Meeting started
            if current_in_meeting and not self.in_meeting:
                self.in_meeting = True
                self.meeting_app = detected_app
                self.meeting_task_name = f"Meeting - {detected_app}"
                
                # Auto-start tracking if not already tracking
                if not self.is_tracking:
                    self.on_quick_start(None, self.meeting_task_name)
                    self.speech_bubble.set_message(f"📞 Joined {detected_app} meeting!")
                    self.notify("Meeting Detected", f"Auto-tracking: {self.meeting_task_name}")
                else:
                    # Just notify, don't interrupt current task
                    self.speech_bubble.set_message(f"📞 {detected_app} call detected")
            
            # State change: Meeting ended
            elif not current_in_meeting and self.in_meeting:
                self.in_meeting = False
                ended_app = self.meeting_app
                self.meeting_app = None
                
                # Stop tracking if we auto-started it
                if self.is_tracking and self.current_task == self.meeting_task_name:
                    self.on_stop()
                    self.speech_bubble.set_message(f"📞 Meeting ended! ({ended_app})")
                    self.notify("Meeting Ended", f"Logged: {self.meeting_task_name}")
                
                self.meeting_task_name = None
            
        except subprocess.TimeoutExpired:
            pass
        except FileNotFoundError:
            # wmctrl not installed, disable feature
            self.auto_track_meetings = False
        except:
            pass
        
        return True
    
    def check_sleepy_mode(self):
        """Check if mascot should enter sleepy mode"""
        try:
            # Check system idle time
            result = subprocess.run(['xprintidle'], capture_output=True, text=True, timeout=2)
            idle_ms = int(result.stdout.strip())
            idle_seconds = idle_ms / 1000
            
            # If idle for too long and not tracking, enter sleepy mode
            if idle_seconds > self.sleepy_threshold and not self.is_tracking:
                if not self.is_sleepy:
                    self.is_sleepy = True
                    self.mascot.set_sleepy(True)
                    sleepy_msg = self.speech_bubble.force_message("sleepy")
                    self.speech_bubble.set_message(sleepy_msg)
            else:
                # Wake up
                if self.is_sleepy:
                    self.is_sleepy = False
                    self.mascot.set_sleepy(False)
                    self.idle_start_time = time.time()
        except:
            pass
        return True
    
    def auto_pause(self):
        if self.is_tracking and not self.is_paused:
            self.is_paused = True
            self.paused_tasks.insert(0, {
                'task': self.current_task,
                'elapsed': self.elapsed_seconds,
                'paused_at': time.time()
            })
            self.save_history()
            self.run_cmd("workpulse stop")
            self.mascot.change_random_state(True, True)
    
