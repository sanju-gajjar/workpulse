    def _menu_action(self, callback):
        """Execute callback and ensure menu closes"""
        if self.menu:
            self.menu.popdown()
            self.menu = None
        # Use idle_add to execute after menu closes
        GLib.idle_add(lambda: callback() if callable(callback) else None)
    
    def _draw_rounded_rect(self, cr, x, y, w, h, r):
        cr.move_to(x + r, y)
        cr.line_to(x + w - r, y)
        cr.arc(x + w - r, y + r, r, -math.pi/2, 0)
        cr.line_to(x + w, y + h - r)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi/2)
        cr.line_to(x + r, y + h)
        cr.arc(x + r, y + h - r, r, math.pi/2, math.pi)
        cr.line_to(x, y + r)
        cr.arc(x + r, y + r, r, math.pi, 3*math.pi/2)
        cr.close_path()
    
    def update_animation(self):
        self.mascot.next_frame()
        
        # Update speech bubble
        self.speech_bubble.update(self.is_tracking, self.is_paused, self.today_hours)
        
        # Dynamic state management with all Iron Man states
        if not hasattr(self, 'state_counter'):
            self.state_counter = 0
            self.state_duration = 0
            self.current_state_time = 0
        
        self.state_counter += 1
        self.current_state_time += 1
        
        # Change states dynamically every 3-6 seconds
        if self.current_state_time >= self.state_duration:
            self.current_state_time = 0
            self.state_duration = random.randint(60, 120)  # 3-6 seconds at 20 FPS
            self.mascot.state_frame = 0  # Reset state frame counter
            
            if self.is_tracking:
                # While working, show all combat/action states
                states = [
                    MascotCharacter.IDLE,
                    MascotCharacter.WORKING,
                    MascotCharacter.THINKING,
                    MascotCharacter.CELEBRATING
                ]
                self.mascot.state = random.choice(states)
            else:
                # When not tracking, show variety of moves
                states = [
                    MascotCharacter.IDLE,
                    MascotCharacter.SLEEPING,
                    MascotCharacter.WAVING,
                    MascotCharacter.JUMPING
                ]
                self.mascot.state = random.choice(states)
        
        self.queue_draw()
        return True
    
    def update_timer(self):
        if self.is_tracking and not self.is_paused and self.task_start_time:
            self.elapsed_seconds = int(time.time() - self.task_start_time)
        return True
    
    def check_idle(self):
        try:
            result = subprocess.run(['xprintidle'], capture_output=True, text=True, timeout=2)
            idle_ms = int(result.stdout.strip())
            idle_seconds = idle_ms / 1000
            
            if idle_seconds > self.idle_threshold:
                if self.is_tracking and not self.is_paused and not self.was_idle:
                    self.was_idle = True
                    self.notify("Idle detected", f"You've been away for {int(idle_seconds/60)} min. Task paused.")
                    self.auto_pause()
            else:
                if self.was_idle:
                    self.was_idle = False
                    if self.paused_tasks:
                        self.notify("Welcome back!", "Click to resume your task.")
        except:
            pass
        return True
    
    def check_break_reminder(self):
        if self.is_tracking and not self.is_paused and self.continuous_work_start:
            continuous_seconds = time.time() - self.continuous_work_start
            
            if continuous_seconds >= self.break_reminder_threshold:
                if time.time() - self.last_break_reminder > 1800:
                    self.last_break_reminder = time.time()
                    hours = int(continuous_seconds / 3600)
                    mins = int((continuous_seconds % 3600) / 60)
                    self.notify("☕ Time for a break!", 
                               f"You've been working for {hours}h {mins}m.\nConsider taking a short break.")
        return True
    
    def check_git_activity(self):
        """Check for recent git commands and celebrate"""
        try:
            activity = self.git_monitor.check_recent_git_activity()
            if activity:
                activity_type, message = activity
                self.speech_bubble.set_message(message)
                self.mascot.state = MascotCharacter.CELEBRATING
